+                  <div className="border border-dashed border-[#5d3214]/45 p-3 text-[10px] text-[#6d4a30]">No active tasks.</div>
+                ) : null}
+              </div>
+            </section>
+          );
+        })}
+      </div>
+    </MachinePanel>
+  );
+}
