+          </div>
+        </MachinePanel>
+
+        <MachinePanel label="Urgent queue" className="p-4">
+          <div className="space-y-2">
+            {snapshot.urgentTasks.slice(0, 8).map(({ project, board, card }) => (
+              <Link key={card.id} href={`/projects/${project.slug}`} className="block border border-[#ff4a3d]/25 bg-[#ff4a3d]/5 p-3 hover:border-[#ff4a3d]/50">
