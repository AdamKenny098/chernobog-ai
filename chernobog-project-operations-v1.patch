+          <input className={inputClass} name="repoName" placeholder="Repository name" required />
+          <input className={inputClass} name="repoPath" placeholder="Local repo path (optional)" />
+          <button className={buttonClass} type="submit">Create workspace</button>
+        </form>
+      </MachinePanel>
+
+      <section className="space-y-3">
+        <SectionLabel overline="portfolio" title="Active projects" right={<code className="text-[9px] text-[#765237]">show projects</code>} />
+        <div className="grid gap-4 xl:grid-cols-2">
+          {snapshot.projects.map((project) => <ProjectCard key={project.id} project={project} />)}
+        </div>
+      </section>
+
+      <section className="grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
+        <MachinePanel label="Recent activity" className="p-4">
+          <ActivityList activity={snapshot.recentActivity} />
+          <Link href="/projects/activity" className="mt-3 inline-block text-[9px] uppercase tracking-[0.18em] text-[#a76d36] hover:text-[#ffd09a]">Open full activity trace</Link>
+        </MachinePanel>
+        <MachinePanel label="Console commands" className="p-4">
+          <div className="space-y-2">
+            {["project operations status", "show urgent tasks", "add task to <project>: <title>", "complete task <task-id>", "set project <name> next action: <action>"].map((command) => (
+              <code key={command} className="block border border-[#5d3214]/45 bg-black/25 p-2 text-[10px] text-[#c9894d]">{command}</code>
+            ))}
+          </div>
+        </MachinePanel>
+      </section>
+    </div>
+  );
+}
