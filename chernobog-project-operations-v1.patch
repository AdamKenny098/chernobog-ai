+                  <div>
+                    <div className="text-xs font-semibold text-[#efb3a7]">{card.title}</div>
+                    <div className="mt-1 text-[9px] uppercase tracking-[0.14em] text-[#8d584c]">{project.name} · {board.name}</div>
