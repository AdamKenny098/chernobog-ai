+      <MachinePanel label="Archive control" className="border-[#ff4a3d]/30 p-4">
+        <p className="text-xs leading-5 text-[#9f7955]">Archiving hides this workspace from active views. Its SQLite record remains recoverable.</p>
+        <form action={archiveProjectAction} className="mt-3">
+          <input type="hidden" name="slug" value={project.slug} />
+          <button className="border border-[#ff4a3d]/40 bg-[#ff4a3d]/5 px-3 py-2 text-[10px] uppercase tracking-[0.18em] text-[#ff9f96] hover:bg-[#ff4a3d]/10" type="submit">Archive project</button>
+        </form>
+      </MachinePanel>
+    </div>
+  );
+}
