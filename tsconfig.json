{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@chernobog/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@chernobog/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@chernobog/events": [
        "./packages/events/src/index.ts"
      ],
      "@chernobog/events/*": [
        "./packages/events/src/*"
      ],
      "@chernobog/tools": [
        "./packages/tools/src/index.ts"
      ],
      "@chernobog/tools/*": [
        "./packages/tools/src/*"
      ],
      "@chernobog/trust": [
        "./packages/trust/src/index.ts"
      ],
      "@chernobog/trust/*": [
        "./packages/trust/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "tools/stable-fast-3d/**/*"
  ]
}
